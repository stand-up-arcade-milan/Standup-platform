# Copiare in .env.demo; sostituire i placeholder prima dell'avvio.
POSTGRES_USER=arcade_admin
POSTGRES_PASSWORD=REPLACE_WITH_A_NEW_RANDOM_PASSWORD
POSTGRES_APP_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_PASSWORD
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=5173
# Sostituire 127.0.0.1 con l'IPv4 privato del portatile host solo per una demo LAN.
API_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
# Generare un segreto casuale dedicato, almeno 32 byte; non riutilizzare password.
ARCADE_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
# Solo per gli account sintetici della demo isolata.
ARCADE_AUTH_LOCAL_TOKENS_ENABLED=true
