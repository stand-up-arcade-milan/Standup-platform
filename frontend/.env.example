# Google OAuth Client ID
# Registra su: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_OAUTH_CLIENT_ID=your-google-client-id

# Microsoft OAuth (opzionale)
# Registra su: https://portal.azure.com
VITE_MICROSOFT_OAUTH_CLIENT_ID=your-microsoft-client-id
VITE_MICROSOFT_OAUTH_TENANT_ID=your-tenant-id
