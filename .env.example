POSTGRES_USER=arcade_admin
POSTGRES_PASSWORD=arcade_dev_only
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=5173

# Accesso con un account Google o Microsoft. Lo stesso client id va messo anche nel
# frontend, in frontend/.env: il server verifica che l'ID token sia stato emesso per
# questa applicazione. Lasciati vuoti, i due pulsanti restano spenti e gli endpoint
# /auth/google e /auth/microsoft rispondono 503.
ARCADE_GOOGLE_CLIENT_ID=
ARCADE_MICROSOFT_CLIENT_ID=
